# Шаблон локального окружения Coins.
# Скопируйте его в .env и укажите свои локальные значения.
# Не добавляйте настоящий .env, пароли, токены или ключи в Git.

# ============================================================
# PostgreSQL — база данных Coins
# ============================================================
DATABASE_URL=jdbc:postgresql://localhost:5432/fitness_exercise_catalog
DATABASE_USERNAME=fitness_exercise_catalog_app
DATABASE_PASSWORD=replace_with_local_password
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10

# ============================================================
# HTTP-сервер Exercise Catalog
# ============================================================
SERVER_PORT=8086
