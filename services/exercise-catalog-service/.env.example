# Локальный HTTP-порт; при необходимости укажите другой в .env.
# Для локальной разработки скопируйте этот шаблон в .env, если файла ещё нет.
# Локальный профиль читает .env; этот файл служит только шаблоном.
# Автоматические тесты используют отдельные настройки и не читают этот файл.
# Не добавляйте настоящие пароли, токены и сертификаты в Git.
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10
DATABASE_URL=jdbc:postgresql://localhost:5432/fitness_exercise_catalog
DATABASE_USERNAME=fitness_exercise_catalog_app
DATABASE_PASSWORD=replace_with_local_password
SERVER_PORT=8086
