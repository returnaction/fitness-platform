# Шаблон локального окружения Challenge.
# Скопируйте его в .env и укажите свои локальные значения.
# Не добавляйте настоящий .env, пароли, токены или ключи в Git.

# ============================================================
# PostgreSQL — база данных Challenge
# ============================================================
DATABASE_URL=jdbc:postgresql://localhost:5432/fitness_challenge
DATABASE_USERNAME=fitness_challenge_app
DATABASE_PASSWORD=replace_with_local_password
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10

# ============================================================
# HTTP-сервер Challenge
# ============================================================
SERVER_PORT=8083

# ============================================================
# Исходящий gRPC Challenge → Coins (mTLS)
# ============================================================
COINS_STAKE_GRPC_HOST=localhost
COINS_STAKE_GRPC_PORT=9092
CHALLENGE_GRPC_CERTIFICATE=secrets/challenge-client.crt
CHALLENGE_GRPC_PRIVATE_KEY=secrets/challenge-client-pkcs8.key
CHALLENGE_GRPC_TRUST_CERTIFICATE=secrets/ca.crt

# ============================================================
# Kafka для outbox
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ============================================================
# Входящий gRPC результата (mTLS)
# ============================================================
CHALLENGE_RESULT_GRPC_ENABLED=true
CHALLENGE_RESULT_GRPC_ADDRESS=0.0.0.0
CHALLENGE_RESULT_GRPC_PORT=9094
CHALLENGE_RESULT_GRPC_CERTIFICATE=secrets/challenge-server.crt
CHALLENGE_RESULT_GRPC_PRIVATE_KEY=secrets/challenge-server-pkcs8.key
CHALLENGE_RESULT_GRPC_TRUST_CERTIFICATE=secrets/ca.crt
CHALLENGE_RESULT_SOURCE_SAN=spiffe://fitness.local/result-source
COINS_SERVICE_SAN=spiffe://fitness.local/coins-service
