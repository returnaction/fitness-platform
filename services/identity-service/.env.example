# Copy this file once to .env with scripts/initialize-identity-local-env.ps1.
# The local profile imports this template first, then applies untracked .env over it.
# The test profile imports only this safe template; Testcontainers replaces its database settings.
# Do not put real passwords, tokens, or certificates into Git.
DATABASE_URL=jdbc:postgresql://localhost:5432/fitness_identity
DATABASE_USERNAME=fitness_identity_app
DATABASE_PASSWORD=postgres
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10
SERVER_PORT=8080
# Включать только после выпуска сертификата Identity и настройки доверенного вызывающего сервиса.
IDENTITY_SESSION_GRPC_ENABLED=false
IDENTITY_SESSION_GRPC_ADDRESS=127.0.0.1
IDENTITY_SESSION_GRPC_PORT=9093
IDENTITY_SESSION_GRPC_CERTIFICATE=secrets/identity-server.crt
IDENTITY_SESSION_GRPC_PRIVATE_KEY=secrets/identity-server-pkcs8.key
IDENTITY_SESSION_GRPC_TRUST_CERTIFICATE=secrets/ca.crt
IDENTITY_SESSION_GRPC_ALLOWED_CALLER=
IDENTITY_REGISTRATION_RATE_CAPACITY=5
IDENTITY_REGISTRATION_RATE_PERIOD_SECONDS=60
IDENTITY_REGISTRATION_RATE_CACHE_SIZE=100000
IDENTITY_REGISTRATION_RATE_CACHE_EXPIRY_SECONDS=600
# Пустое значение запрещает доверять заголовкам; адрес прокси указывается только при защищённом соединении с ним.
IDENTITY_REGISTRATION_TRUSTED_PROXY_IP=
# Локальная разработка: отдельный приватный ключ JWT в игнорируемой Git папке secrets.
IDENTITY_JWT_ENABLED=false
IDENTITY_JWT_PRIVATE_KEY=secrets/identity-jwt-private.pem
IDENTITY_JWT_PUBLIC_KEY=secrets/identity-jwt-public.pem
IDENTITY_JWT_KEY_ID=local-identity-1
IDENTITY_JWT_ISSUER=http://localhost:8080
IDENTITY_JWT_AUDIENCE=fitness-gateway
IDENTITY_ACCOUNTS_GRPC_ENABLED=false
IDENTITY_ACCOUNTS_GRPC_HOST=localhost
IDENTITY_ACCOUNTS_GRPC_PORT=9091
IDENTITY_ACCOUNTS_GRPC_CERTIFICATE=secrets/identity-client.crt
IDENTITY_ACCOUNTS_GRPC_PRIVATE_KEY=secrets/identity-client-pkcs8.key
IDENTITY_ACCOUNTS_GRPC_TRUST_CERTIFICATE=secrets/ca.crt
IDENTITY_COINS_GRPC_ENABLED=false
IDENTITY_COINS_GRPC_HOST=localhost
IDENTITY_COINS_GRPC_PORT=9092
IDENTITY_COINS_GRPC_CERTIFICATE=secrets/identity-client.crt
IDENTITY_COINS_GRPC_PRIVATE_KEY=secrets/identity-client-pkcs8.key
IDENTITY_COINS_GRPC_TRUST_CERTIFICATE=secrets/ca.crt
IDENTITY_REGISTRATION_WORKER_ENABLED=false
IDENTITY_REGISTRATION_WORKER_POLL_MS=5000
IDENTITY_REGISTRATION_WORKER_BATCH_SIZE=4
IDENTITY_REGISTRATION_WORKER_LEASE_SECONDS=30
IDENTITY_REGISTRATION_RETRY_INITIAL_SECONDS=5
IDENTITY_REGISTRATION_RETRY_MAX_SECONDS=300
IDENTITY_REGISTRATION_RETRY_JITTER_FRACTION=0.2
