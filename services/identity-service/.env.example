# Copy this file once to .env with scripts/initialize-identity-local-env.ps1.
# Spring Boot imports .env automatically only when the local profile is active.
# Do not put real passwords, tokens, or certificates into Git.
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/fitness_identity
DATABASE_USERNAME=fitness_identity_app
DATABASE_PASSWORD=postgres
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10
SERVER_PORT=8080
