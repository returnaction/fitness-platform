# Локальный API и отдельный management-порт; внешнее развёртывание не входит в v1.
SERVER_PORT=8088
MANAGEMENT_PORT=8089
GATEWAY_ADDRESS=127.0.0.1
GATEWAY_IDENTITY_URL=http://127.0.0.1:8080
GATEWAY_JWKS_URL=http://127.0.0.1:8080/.well-known/jwks.json
GATEWAY_JWT_ISSUER=http://localhost:8080
GATEWAY_JWT_AUDIENCE=fitness-gateway
GATEWAY_MAX_BODY_BYTES=16384
GATEWAY_RATE_CAPACITY=60
GATEWAY_RATE_PERIOD_SECONDS=60
GATEWAY_MAX_CLIENTS=10000
GATEWAY_JWKS_TTL_SECONDS=300
GATEWAY_JWKS_REFRESH_SECONDS=5
# Identity может ожидать подготовку регистрации 12 секунд; оставляем запас.
GATEWAY_HTTP_TIMEOUT_MILLIS=15000
GATEWAY_SESSION_HOST=localhost
GATEWAY_SESSION_PORT=9093
# Сертификат клиента с URI SAN spiffe://fitness.local/gateway-service.
GATEWAY_CERTIFICATE=secrets/gateway-client.crt
GATEWAY_PRIVATE_KEY=secrets/gateway-client-pkcs8.key
GATEWAY_TRUST_CERTIFICATE=secrets/ca.crt
GATEWAY_SESSION_TIMEOUT_MILLIS=2500
