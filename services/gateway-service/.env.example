# Шаблон local, согласованный с .env.example Identity; сертификаты предоставить отдельно.
# При добавлении параметров обновляйте также локальный .env, сохраняя его значения.
# Порты Gateway: API и отдельный management на loopback.
SERVER_PORT=8088
MANAGEMENT_PORT=9088
GATEWAY_ADDRESS=127.0.0.1
# Адрес Identity и его открытых JWT-ключей.
IDENTITY_HTTP_BASE_URL=http://127.0.0.1:8080
GATEWAY_JWKS_URL=http://127.0.0.1:8080/.well-known/jwks.json
# Issuer и audience должны точно совпадать с настройками Identity.
GATEWAY_JWT_ISSUER=http://localhost:8080
GATEWAY_JWT_AUDIENCE=fitness-gateway
IDENTITY_SESSION_HOST=localhost
IDENTITY_SESSION_PORT=9093
# Пути ниже рассчитаны на запуск из корня репозитория.
# Для запуска из другого каталога задайте абсолютные пути с /.
GATEWAY_TRUST_CERTIFICATE=secrets/ca.crt
GATEWAY_CERTIFICATE=secrets/gateway-client.crt
GATEWAY_PRIVATE_KEY=secrets/gateway-client-pkcs8.key
# Ожидание закрытия gRPC-канала при остановке приложения.
SESSION_SHUTDOWN_TIMEOUT=5s
