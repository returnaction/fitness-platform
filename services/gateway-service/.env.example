# Пример для local; сертификаты предоставить отдельно.
SERVER_PORT=8088
MANAGEMENT_PORT=9088
GATEWAY_ADDRESS=127.0.0.1
IDENTITY_HTTP_BASE_URL=http://127.0.0.1:8081
GATEWAY_JWKS_URL=http://127.0.0.1:8081/.well-known/jwks.json
GATEWAY_JWT_ISSUER=identity
GATEWAY_JWT_AUDIENCE=fitness-gateway
IDENTITY_SESSION_HOST=localhost
IDENTITY_SESSION_PORT=9091
GATEWAY_TRUST_CERTIFICATE=secrets/ca.crt
GATEWAY_CERTIFICATE=secrets/gateway.crt
GATEWAY_PRIVATE_KEY=secrets/gateway.key
SESSION_SHUTDOWN_TIMEOUT=5s
