# Шаблон локального окружения Gateway.
# Скопируйте его в .env и укажите свои локальные значения.
# Не добавляйте настоящий .env, пароли, токены или ключи в Git.

# ============================================================
# HTTP-сервер Gateway и служебный management-порт
# ============================================================
SERVER_PORT=8088
MANAGEMENT_PORT=9088
GATEWAY_ADDRESS=127.0.0.1

# ============================================================
# Identity по HTTP и открытые JWT-ключи
# ============================================================
IDENTITY_HTTP_BASE_URL=http://127.0.0.1:8080
GATEWAY_JWKS_URL=http://127.0.0.1:8080/.well-known/jwks.json

# ============================================================
# JWT — значения должны совпадать с настройками Identity
# ============================================================
GATEWAY_JWT_ISSUER=http://localhost:8080
GATEWAY_JWT_AUDIENCE=fitness-gateway

# ============================================================
# Исходящий gRPC: Gateway → Identity (mTLS)
# ============================================================
IDENTITY_SESSION_HOST=localhost
IDENTITY_SESSION_PORT=9093
GATEWAY_TRUST_CERTIFICATE=secrets/ca.crt
GATEWAY_CERTIFICATE=secrets/gateway-client.crt
GATEWAY_PRIVATE_KEY=secrets/gateway-client-pkcs8.key
SESSION_SHUTDOWN_TIMEOUT=5s

# ============================================================
# Accounts по HTTP
# ============================================================
ACCOUNT_HTTP_BASE_URL=http://127.0.0.1:8081

# ============================================================
# Coins по HTTP
# ============================================================
COINS_HTTP_BASE_URL=http://127.0.0.1:8082

# ============================================================
# Exercise Catalog по HTTP
# ============================================================
EXERCISE_CATALOG_HTTP_BASE_URL=http://127.0.0.1:8086
