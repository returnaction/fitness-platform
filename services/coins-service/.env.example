# Локальные значения: скопируйте в .env и укажите пароль своей роли PostgreSQL.
DATABASE_URL=jdbc:postgresql://localhost:5432/fitness_coins
DATABASE_USERNAME=fitness_coins_app
DATABASE_PASSWORD=replace_with_local_password
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10
SERVER_PORT=8082
COINS_GRPC_ENABLED=false
COINS_GRPC_ADDRESS=127.0.0.1
COINS_GRPC_PORT=9092
COINS_GRPC_CERTIFICATE=secrets/coins-server.crt
COINS_GRPC_PRIVATE_KEY=secrets/coins-server-pkcs8.key
COINS_GRPC_TRUST_CERTIFICATE=secrets/ca.crt
