# Шаблон локального окружения Coins.
# Скопируйте его в .env и укажите свои локальные значения.
# Не добавляйте настоящий .env, пароли, токены или ключи в Git.

# ============================================================
# PostgreSQL — база данных Coins
# ============================================================
DATABASE_URL=jdbc:postgresql://localhost:5432/fitness_coins
DATABASE_USERNAME=fitness_coins_app
DATABASE_PASSWORD=replace_with_local_password
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10

# ============================================================
# HTTP-сервер Coins
# ============================================================
SERVER_PORT=8082

# ============================================================
# Входящий gRPC: Identity → Coins (mTLS)
# ============================================================
COINS_GRPC_ADDRESS=127.0.0.1
COINS_GRPC_PORT=9092
COINS_GRPC_CERTIFICATE=secrets/coins-server.crt
COINS_GRPC_PRIVATE_KEY=secrets/coins-server-pkcs8.key
COINS_GRPC_TRUST_CERTIFICATE=secrets/ca.crt

# ============================================================
# Исходящий gRPC: Coins → Challenge (mTLS)
# ============================================================
CHALLENGE_RESULTS_GRPC_HOST=localhost
CHALLENGE_RESULTS_GRPC_PORT=9094
COINS_CLIENT_CERTIFICATE=secrets/coins-client.crt
COINS_CLIENT_PRIVATE_KEY=secrets/coins-client-pkcs8.key
CHALLENGE_RESULTS_GRPC_TRUST_CERTIFICATE=secrets/ca.crt
CHALLENGE_RESULTS_GRPC_DEADLINE=3s

# ============================================================
# Kafka: challenge.finished → settlement
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
COINS_CHALLENGE_FINISHED_CONSUMER_ENABLED=true
CHALLENGE_FINISHED_TOPIC=fitness.challenge.finished.v1
CHALLENGE_FINISHED_CONSUMER_GROUP=coins-service.challenge-finished

# ============================================================
# Outbox publisher
# ============================================================
COINS_OUTBOX_LEASE=30s
COINS_OUTBOX_BATCH=20
COINS_OUTBOX_FIXED_DELAY=2s
