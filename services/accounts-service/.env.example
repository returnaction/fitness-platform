# Шаблон локального окружения Accounts.
# Скопируйте его в .env и укажите свои локальные значения.
# Не добавляйте настоящий .env, пароли, токены или ключи в Git.

# ============================================================
# PostgreSQL — база данных Accounts
# ============================================================
DATABASE_URL=jdbc:postgresql://localhost:5432/fitness_accounts
DATABASE_USERNAME=fitness_accounts_app
DATABASE_PASSWORD=replace_with_local_password
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10

# ============================================================
# HTTP-сервер Accounts
# ============================================================
SERVER_PORT=8081

# ============================================================
# Входящий gRPC: Identity → Accounts (mTLS)
# ============================================================
ACCOUNTS_GRPC_ADDRESS=127.0.0.1
ACCOUNTS_GRPC_PORT=9091
ACCOUNTS_GRPC_CERTIFICATE=secrets/accounts-server.crt
ACCOUNTS_GRPC_PRIVATE_KEY=secrets/accounts-server-pkcs8.key
ACCOUNTS_GRPC_TRUST_CERTIFICATE=secrets/ca.crt
