# Copy this file to .env for local development if .env does not already exist.
# The local profile imports this template first, then applies untracked .env over it.
# The test profile imports only this safe template; Testcontainers replaces its database settings.
# Do not put real passwords, tokens, or certificates into Git.
DATABASE_URL=jdbc:postgresql://localhost:5432/fitness_accounts
DATABASE_USERNAME=fitness_accounts_app
DATABASE_PASSWORD=postgres
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10
SERVER_PORT=8081
