# Шаблон env-файла для dev-сервера Identity.
# На VPS скопировать как /opt/fitness-platform/secrets/identity.env.
# Не добавлять настоящий файл, пароли, токены или ключи в Git.

# ============================================================
# PostgreSQL
# ============================================================
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/fitness_identity
DATABASE_USERNAME=fitness_identity_app
DATABASE_PASSWORD=<SET_ON_VPS>
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10

# ============================================================
# HTTP и входящий gRPC: Gateway → Identity
# ============================================================
SERVER_PORT=8080
IDENTITY_MANAGEMENT_PORT=9080
IDENTITY_SESSION_GRPC_ADDRESS=0.0.0.0
IDENTITY_SESSION_GRPC_PORT=9093
IDENTITY_SESSION_GRPC_CERTIFICATE=/run/fitness-platform/crypto/identity-server.crt
IDENTITY_SESSION_GRPC_PRIVATE_KEY=/run/fitness-platform/crypto/identity-server-pkcs8.key
IDENTITY_SESSION_GRPC_TRUST_CERTIFICATE=/run/fitness-platform/crypto/ca.crt
IDENTITY_SESSION_GRPC_ALLOWED_CALLER=spiffe://fitness.local/gateway-service

# ============================================================
# JWT — ключи создаются только на VPS
# ============================================================
IDENTITY_JWT_PRIVATE_KEY=/run/fitness-platform/crypto/identity-jwt-private.pem
IDENTITY_JWT_PUBLIC_KEY=/run/fitness-platform/crypto/identity-jwt-public.pem
IDENTITY_JWT_KEY_ID=dev-identity-1
IDENTITY_JWT_ISSUER=<SET_ON_VPS_AND_COPY_TO_GATEWAY>
IDENTITY_JWT_AUDIENCE=fitness-gateway

# ============================================================
# Исходящий gRPC: Identity → Accounts и Coins (mTLS)
# ============================================================
IDENTITY_ACCOUNTS_GRPC_HOST=accounts-service
IDENTITY_ACCOUNTS_GRPC_PORT=9091
IDENTITY_ACCOUNTS_GRPC_CERTIFICATE=/run/fitness-platform/crypto/identity-client.crt
IDENTITY_ACCOUNTS_GRPC_PRIVATE_KEY=/run/fitness-platform/crypto/identity-client-pkcs8.key
IDENTITY_ACCOUNTS_GRPC_TRUST_CERTIFICATE=/run/fitness-platform/crypto/ca.crt
IDENTITY_COINS_GRPC_HOST=coins-service
IDENTITY_COINS_GRPC_PORT=9092
IDENTITY_COINS_GRPC_CERTIFICATE=/run/fitness-platform/crypto/identity-client.crt
IDENTITY_COINS_GRPC_PRIVATE_KEY=/run/fitness-platform/crypto/identity-client-pkcs8.key
IDENTITY_COINS_GRPC_TRUST_CERTIFICATE=/run/fitness-platform/crypto/ca.crt

# ============================================================
# Регистрация и фоновый worker
# ============================================================
IDENTITY_REGISTRATION_RESPONSE_WAIT_MS=12000
IDENTITY_REGISTRATION_RESPONSE_POLL_MS=250
IDENTITY_REGISTRATION_WORKER_POLL_MS=5000
IDENTITY_REGISTRATION_WORKER_BATCH_SIZE=20
IDENTITY_REGISTRATION_WORKER_PARALLELISM=4
IDENTITY_REGISTRATION_WORKER_LEASE_SECONDS=30
IDENTITY_REGISTRATION_RETRY_INITIAL_SECONDS=5
IDENTITY_REGISTRATION_RETRY_MAX_SECONDS=300
IDENTITY_REGISTRATION_RETRY_JITTER_FRACTION=0.2
