# Шаблон env-файла для dev-сервера Exercise Catalog.
# На VPS скопировать как /opt/fitness-platform/secrets/exercise-catalog.env.
# Не добавлять настоящий файл, пароли, токены или ключи в Git.

# ============================================================
# PostgreSQL
# ============================================================
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/fitness_exercise_catalog
DATABASE_USERNAME=fitness_exercise_catalog_app
DATABASE_PASSWORD=<SET_ON_VPS>
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10

# ============================================================
# HTTP-порт
# ============================================================
SERVER_PORT=8086
