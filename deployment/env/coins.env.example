# Шаблон env-файла для dev-сервера Coins.
# На VPS скопировать как /opt/fitness-platform/secrets/coins.env.
# Не добавлять настоящий файл, пароли, токены или ключи в Git.

# ============================================================
# PostgreSQL
# ============================================================
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/fitness_coins
DATABASE_USERNAME=fitness_coins_app
DATABASE_PASSWORD=<SET_ON_VPS>
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10

# ============================================================
# HTTP и входящий gRPC: Identity → Coins (mTLS)
# ============================================================
SERVER_PORT=8082
COINS_GRPC_ADDRESS=0.0.0.0
COINS_GRPC_PORT=9092
COINS_GRPC_CERTIFICATE=/run/fitness-platform/crypto/coins-server.crt
COINS_GRPC_PRIVATE_KEY=/run/fitness-platform/crypto/coins-server-pkcs8.key
COINS_GRPC_TRUST_CERTIFICATE=/run/fitness-platform/crypto/ca.crt
