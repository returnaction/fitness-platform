# Шаблон env-файла для dev-сервера Accounts.
# На VPS скопировать как /opt/fitness-platform/secrets/accounts.env.
# Не добавлять настоящий файл, пароли, токены или ключи в Git.

# ============================================================
# PostgreSQL
# ============================================================
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/fitness_accounts
DATABASE_USERNAME=fitness_accounts_app
DATABASE_PASSWORD=<SET_ON_VPS>
DATABASE_POOL_MIN_IDLE=2
DATABASE_POOL_MAX_SIZE=10

# ============================================================
# HTTP и входящий gRPC: Identity → Accounts (mTLS)
# ============================================================
SERVER_PORT=8081
ACCOUNTS_GRPC_ADDRESS=0.0.0.0
ACCOUNTS_GRPC_PORT=9091
ACCOUNTS_GRPC_CERTIFICATE=/run/fitness-platform/crypto/accounts-server.crt
ACCOUNTS_GRPC_PRIVATE_KEY=/run/fitness-platform/crypto/accounts-server-pkcs8.key
ACCOUNTS_GRPC_TRUST_CERTIFICATE=/run/fitness-platform/crypto/ca.crt
