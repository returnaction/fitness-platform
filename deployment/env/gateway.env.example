# Шаблон env-файла для dev-сервера Gateway.
# На VPS скопировать как /opt/fitness-platform/secrets/gateway.env.
# Не добавлять настоящий файл, пароли, токены или ключи в Git.

# ============================================================
# HTTP-порты
# ============================================================
SERVER_PORT=8088
MANAGEMENT_PORT=9088

# ============================================================
# Внутренние HTTP-адреса Docker-сети
# ============================================================
IDENTITY_HTTP_BASE_URL=http://identity-service:8080
GATEWAY_JWKS_URL=http://identity-service:8080/.well-known/jwks.json
ACCOUNT_HTTP_BASE_URL=http://accounts-service:8081

# ============================================================
# JWT — должны совпадать со значениями Identity
# ============================================================
GATEWAY_JWT_ISSUER=<SET_ONCE_AND_COPY_FROM_IDENTITY>
GATEWAY_JWT_AUDIENCE=fitness-gateway

# ============================================================
# Исходящий gRPC: Gateway → Identity (mTLS)
# ============================================================
IDENTITY_SESSION_HOST=identity-service
IDENTITY_SESSION_PORT=9093
GATEWAY_TRUST_CERTIFICATE=/run/fitness-platform/crypto/ca.crt
GATEWAY_CERTIFICATE=/run/fitness-platform/crypto/gateway-client.crt
GATEWAY_PRIVATE_KEY=/run/fitness-platform/crypto/gateway-client-pkcs8.key
SESSION_SHUTDOWN_TIMEOUT=5s
