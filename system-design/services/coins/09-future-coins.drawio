<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="future-coins" name="Будущий сервис Coins">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="COINS — виртуальные монеты в будущей системе" style="text;html=1;align=center;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="20" width="1000" height="40" as="geometry"/></mxCell>
        <mxCell id="challenge_service" value="CHALLENGE&#xa;условия вступления и итог соревнования" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="270" height="95" as="geometry"/></mxCell>
        <mxCell id="coins_boundary" value="COINS — собственная область данных и операций" style="swimlane;whiteSpace=wrap;html=1;startSize=45;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="115" width="720" height="600" as="geometry"/></mxCell>
        <mxCell id="operation" value="Операция с монетами&#xa;проверка, резерв, освобождение, распределение&#xa;повтор по одному ID не создаёт дубль" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="coins_boundary"><mxGeometry x="130" y="85" width="470" height="100" as="geometry"/></mxCell>
        <mxCell id="wallet" value="Кошелёк&#xa;доступный и зарезервированный баланс" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="coins_boundary"><mxGeometry x="35" y="290" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="holds" value="Резервы ставок&#xa;пользователь, challenge, сумма, состояние" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="coins_boundary"><mxGeometry x="270" y="290" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="ledger" value="Ledger&#xa;неизменяемая история операций; исправление — новая запись" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="coins_boundary"><mxGeometry x="505" y="290" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="atomic_note" value="Резерв: проверка баланса, изменение кошелька, запись резерва и ledger — одна транзакция внутри Coins. Два одновременных запроса не могут потратить одни монеты дважды." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;spacing=10;" vertex="1" parent="coins_boundary"><mxGeometry x="80" y="465" width="560" height="90" as="geometry"/></mxCell>
        <mxCell id="separate_note" value="Challenge не меняет данные Coins напрямую. Неудачное вступление → отдельная операция освобождения резерва. Реальные деньги и выплаты в текущий продукт не входят." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="490" width="290" height="155" as="geometry"/></mxCell>
        <mxCell id="edge_c" value="команда / результат" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="challenge_service" target="operation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_w" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="coins_boundary" source="operation" target="wallet"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_h" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="coins_boundary" source="operation" target="holds"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_l" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="coins_boundary" source="operation" target="ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
