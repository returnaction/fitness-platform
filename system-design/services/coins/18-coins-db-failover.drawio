<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="coins-db-failover" name="Coins — основная и реплика"><mxGraphModel grid="1" page="1" pageWidth="1600" pageHeight="1200"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="heading_failover" value="COINS: основная база А и реплика Б — без переключения" style="text;html=1;align=center;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="30" width="1150" height="45" as="geometry"/></mxCell>
<mxCell id="coins_service" value="Сервис Coins&#xa;операции с виртуальными монетами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="150" width="260" height="85" as="geometry"/></mxCell>
<mxCell id="write_endpoint" value="Подключение к основной базе А&#xa;при её отказе запись недоступна" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="470" y="145" width="300" height="95" as="geometry"/></mxCell>
<mxCell id="primary_db" value="Основная PostgreSQL&#xa;принимает запись&#xa;ждёт синхронное подтверждение" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="280" height="130" as="geometry"/></mxCell>
<mxCell id="standby_db" value="Синхронная реплика Б&#xa;подтверждает сохранение записи&#xa;основной не становится" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="900" y="380" width="280" height="130" as="geometry"/></mxCell>
<mxCell id="controller" value="Наблюдение и восстановление&#xa;при отказе А ждём её восстановления;&#xa;без подтверждения Б запись не подтверждается;&#xa;проверяем согласованность после восстановления" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="340" y="390" width="420" height="150" as="geometry"/></mxCell>
<mxCell id="backup_note" value="Отдельные резервные копии + журнал изменений: восстановление после ошибок и повреждений. Реплика не заменяет backup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="890" y="660" width="350" height="100" as="geometry"/></mxCell>
<mxCell id="limitations_note" value="УЧЕБНАЯ МОДЕЛЬ: при отказе А запись ждёт её восстановления; Б не становится основной. При отказе Б без её подтверждения успех не выдаётся. RTO до 5 минут не гарантирован: восстановление А может занять дольше. Потерянный ответ проверяется по ID операции. Отказ контейнера не равен потере физической машины." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="820" width="1140" height="125" as="geometry"/></mxCell>
<mxCell id="edge_coins_endpoint" value="запись" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="coins_service" target="write_endpoint"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge_endpoint_primary" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="write_endpoint" target="primary_db"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge_primary_standby" value="передача и подтверждение" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;" edge="1" parent="1" source="primary_db" target="standby_db"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge_control_primary" value="наблюдение за А" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="controller" target="primary_db"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge_control_standby" value="наблюдение за Б" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="controller" target="standby_db"><mxGeometry relative="1" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
