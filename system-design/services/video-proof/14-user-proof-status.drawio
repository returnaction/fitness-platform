<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="user-proof-status" name="Статус видео участника"><mxGraphModel grid="1" page="1" pageWidth="1500" pageHeight="1000"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title_status" value="БУДУЩЕЕ: как участник узнаёт статус видео" style="text;html=1;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="30" width="1100" height="45" as="geometry"/></mxCell>
<mxCell id="video_source" value="VIDEO PROOF&#xa;загрузка и готовность видео" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="140" width="250" height="85" as="geometry"/></mxCell>
<mxCell id="mod_source" value="MODERATION&#xa;решение о видео" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="250" height="85" as="geometry"/></mxCell>
<mxCell id="kafka_status" value="KAFKA&#xa;подтверждённые события&#xa;через Outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="215" width="240" height="95" as="geometry"/></mxCell>
<mxCell id="challenge_status" value="CHALLENGE + PostgreSQL&#xa;состояние задания и отправки&#xa;API проверяет права участника" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="770" y="215" width="300" height="100" as="geometry"/></mxCell>
<mxCell id="phone_status" value="ПРИЛОЖЕНИЕ УЧАСТНИКА&#xa;запрашивает статус при открытии / обновлении&#xa;показывает понятный результат" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="770" y="480" width="300" height="105" as="geometry"/></mxCell>
<mxCell id="notify_status" value="NOTIFICATIONS&#xa;сообщения с учётом настроек&#xa;push не является источником результата" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="480" width="260" height="105" as="geometry"/></mxCell>
<mxCell id="status_note" value="Экран: Загружается / На проверке / Одобрено / Отклонено / Видео не принято.&#xa;Ошибка сети — не признак отсутствия отправки. Прогресс телефона — не подтверждение приёма сервером. Доставка событий может задерживаться." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="125" y="700" width="1030" height="100" as="geometry"/></mxCell>
<mxCell id="edge_video_status" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="video_source" target="kafka_status"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge_mod_status" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="mod_source" target="kafka_status"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge_kafka_challenge" value="события" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="kafka_status" target="challenge_status"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge_phone_challenge" value="запрос / ответ" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;" edge="1" parent="1" source="phone_status" target="challenge_status"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge_challenge_notify" value="событие через Kafka" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="challenge_status" target="notify_status"><mxGeometry relative="1" as="geometry"/></mxCell>
