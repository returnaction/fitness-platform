<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="future-challenge-join" name="Будущее вступление в challenge">
    <mxGraphModel dx="1300" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="ВСТУПЛЕНИЕ: сначала резерв монет, затем место&#xa;Учебная схема будущих сервисов — не текущая реализация" style="text;html=1;align=center;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="20" width="980" height="65" as="geometry"/></mxCell>
        <mxCell id="start" value="Участник нажал «Вступить»&#xa;операция получает уникальный ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="120" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="check" value="Challenge проверяет общие условия вступления&#xa;место пока не резервируется" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="250" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="hold" value="Coins одной операцией проверяет доступный баланс&#xa;и временно резервирует ставку" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="395" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="poor" value="Недостаточно монет&#xa;отказ, место не занималось" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="join_step" value="Challenge повторно проверяет набор и место;&#xa;атомарно занимает место и подтверждает участие" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="560" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="success" value="Участие подтверждено&#xa;ставка остаётся зарезервированной" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="210" y="750" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="release" value="Нет места / набор закрыт&#xa;Coins освобождает резерв ставки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="690" y="750" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="note" value="При сбое или потерянном ответе операция остаётся в обработке: система выясняет результат по её ID и безопасно повторяет шаги. Повтор не создаёт вторую ставку или участие. Освобождение резерва должно быть надёжным. Порядок восстановления и ограничения ожидания ещё проектируются. Все монеты виртуальные." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="365" y="945" width="520" height="140" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="start" target="check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="условия подходят" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="check" target="hold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="не хватает" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="hold" target="poor"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="резерв создан" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="hold" target="join_step"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="место получено" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="join_step" target="success"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="не получилось вступить" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="join_step" target="release"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
