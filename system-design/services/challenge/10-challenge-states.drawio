<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="challenge-states-diagram" name="Состояния challenge и участника">
    <mxGraphModel dx="1400" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="heading" value="CHALLENGE — согласованная модель состояний" style="text;html=1;align=center;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="20" width="1250" height="45" as="geometry"/></mxCell>
        <mxCell id="draft_state" value="DRAFT&#xa;Черновик" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="open_state" value="OPEN&#xa;Набор участников" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="150" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="active_state" value="ACTIVE&#xa;Challenge идёт" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="150" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="review_state" value="AWAITING_RESULTS&#xa;Ожидание результатов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="350" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="finished_state" value="FINISHED&#xa;Завершён" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="540" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="cancel_state" value="CANCELLED&#xa;Отменён" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="350" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="participant_box" value="СОСТОЯНИЕ УЧАСТНИКА&#xa;JOINED → ACTIVE / AWAITING_DECISION → ELIMINATED / WINNER / COMPLETED.&#xa;Ожидание решения позволяет выполнять следующие задания.&#xa;Состояния заданий и апелляций учитываются отдельно." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="90" y="760" width="580" height="150" as="geometry"/></mxCell>
        <mxCell id="difference_note" value="ПРАВИЛА&#xa;OPEN: набор закрывается при заполнении, но challenge остаётся OPEN до старта.&#xa;Добровольный выход после вступления запрещён.&#xa;При досрочном результате ACTIVE → FINISHED, если все решения окончательны." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="760" y="760" width="600" height="165" as="geometry"/></mxCell>
        <mxCell id="levels_example" value="ПРИМЕР: ДЕНЬ АНИ УЖЕ ЗАКОНЧИЛСЯ&#xa;Challenge: ACTIVE — следующие дни идут по расписанию.&#xa;Аня: AWAITING_DECISION — можно выполнять следующие задания.&#xa;День Ани: AWAITING_RESULTS — ещё не все решения готовы.&#xa;Приседания: COMPLETED; отжимания: AWAITING_APPEAL; пресс: UNDER_REVIEW.&#xa;Апелляцию удовлетворили → отжимания COMPLETED. День завершён, когда одобрены все задания.&#xa;Если обязательное задание окончательно FAILED → день FAILED, Аня ELIMINATED." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="90" y="970" width="1270" height="185" as="geometry"/></mxCell>
        <mxCell id="edge_draft_open" value="публикация + ставка создателя" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="draft_state" target="open_state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_open_active" value="старт по условиям challenge" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="open_state" target="active_state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_open_cancel" value="отмена по условиям" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="open_state" target="cancel_state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_active_review" value="ожидание проверки" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="active_state" target="review_state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_review_finished" value="итог определён" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="review_state" target="finished_state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_active_finished" value="досрочный окончательный итог" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="active_state" target="finished_state"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="190"/><mxPoint x="1250" y="580"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
