        </mxCell>
        <mxCell id="moduser" value="Модератор&#xa;приложение / Review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="990" y="120" width="240" height="90" as="geometry" />
        </mxCell>
