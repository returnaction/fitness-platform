<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.1.2 Chrome/138.0.7204.243 Electron/37.4.0 Safari/537.36" version="28.1.2">
  <diagram id="future-system-overview" name="Общая карта будущей системы">
    <mxGraphModel dx="2305" dy="1201" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="БУДУЩАЯ СИСТЕМА — учебная карта, границы ещё обсуждаются" style="text;html=1;align=center;fontSize=21;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="130" y="30" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="user" value="Участник&#xa;мобильное приложение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" parent="1" vertex="1">
