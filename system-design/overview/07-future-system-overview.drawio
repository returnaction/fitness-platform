        </mxCell>
        <mxCell id="identity" value="Identity + Accounts (два сервиса)&#xa;вход и ограничения / профиль&#xa;новые вступления могут быть запрещены" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="85" y="360" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="challenge" value="Challenge&#xa;участники, задания, результаты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="430" y="360" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="catalog" value="Каталог упражнений&#xa;описания и вариации" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="85" y="580" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="video" value="Video Proof&#xa;запись и подготовка видео&#xa;RabbitMQ: задачи worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="780" y="360" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="rabbit_jobs" value="RabbitMQ&#xa;quorum queue: ID задачи" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="1580" y="340" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="video_worker" value="Video worker&#xa;захватывает задачу в PostgreSQL;&#xa;проверяет и собирает видео" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="1900" y="460" width="280" height="100" as="geometry" />
