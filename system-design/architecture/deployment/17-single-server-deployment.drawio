<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="single-server-learning" name="Учебный стенд — один сервер">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="heading_deploy" value="УЧЕБНЫЙ СТЕНД: все компоненты на одном сервере" style="text;html=1;align=center;fontSize=21;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="20" width="1300" height="50" as="geometry"/></mxCell>
        <mxCell id="phone_deploy" value="Телефон&#xa;участника / модератора" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="server_deploy" value="ОДИН СЕРВЕР — контейнеры и данные стенда" style="swimlane;whiteSpace=wrap;html=1;startSize=40;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="250" width="1510" height="900" as="geometry"/></mxCell>
        <mxCell id="gateway_deploy" value="API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="server_deploy"><mxGeometry x="70" y="85" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="apps_deploy" value="ОТДЕЛЬНЫЕ КОНТЕЙНЕРЫ СЕРВИСОВ&#xa;Identity · Accounts · Challenge · Coins&#xa;Video Proof · Moderation · Каталог · Notifications&#xa;&#xa;Связь через интерфейсы; не менять чужие таблицы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="server_deploy"><mxGeometry x="360" y="75" width="510" height="120" as="geometry"/></mxCell>
        <mxCell id="jobs_deploy" value="Worker обработки видео&#xa;можно запускать отдельно от API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="server_deploy"><mxGeometry x="1050" y="85" width="310" height="90" as="geometry"/></mxCell>
        <mxCell id="database_deploy" value="PostgreSQL — основные базы и реплики&#xa;учебные контейнеры; данные и права сервисов разделены&#xa;число экземпляров и размещение логических БД уточняются" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="server_deploy"><mxGeometry x="350" y="340" width="380" height="130" as="geometry"/></mxCell>
        <mxCell id="broker_kafka" value="Kafka + KRaft&#xa;3 учебных узла&#xa;события между сервисами" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="server_deploy"><mxGeometry x="820" y="330" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="broker_rabbit" value="RabbitMQ&#xa;3 учебных узла / quorum queue&#xa;задачи обработки видео" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="server_deploy"><mxGeometry x="1110" y="330" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="storage_deploy" value="S3-совместимые хранилища A / Б&#xa;части и готовые видео&#xa;копирование из A в Б" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="server_deploy"><mxGeometry x="790" y="550" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="note_deploy" value="Граница стенда: отказ одного физического сервера затрагивает все контейнеры. Реплика или копия на той же машине не защищает от потери сервера. RPO 0 и автоматическое восстановление — будущие цели, не гарантия этой схемы. Сетевые права, резервные копии и реальные конфигурации ещё проектируются." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;align=left;spacing=12;" vertex="1" parent="server_deploy"><mxGeometry x="130" y="700" width="1200" height="120" as="geometry"/></mxCell>
        <mxCell id="edge_user_gateway" value="API" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="phone_deploy" target="gateway_deploy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_gateway_apps" value="запросы" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="server_deploy" source="gateway_deploy" target="apps_deploy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_apps_database" value="свои данные" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="server_deploy" source="apps_deploy" target="database_deploy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_apps_kafka" value="события" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;" edge="1" parent="server_deploy" source="apps_deploy" target="broker_kafka"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_apps_rabbit" value="ID задач" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="server_deploy" source="apps_deploy" target="broker_rabbit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_rabbit_worker" value="задачи" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="server_deploy" source="broker_rabbit" target="jobs_deploy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_worker_storage" value="файлы" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;" edge="1" parent="server_deploy" source="jobs_deploy" target="storage_deploy"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
