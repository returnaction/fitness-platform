# Единые правила форматирования: IDE применяет их ко всем файлам проекта,
# чтобы код выглядел одинаково на Windows, Linux и у разных разработчиков.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf


# ==============================================================================
# ВНИМАНИЕ! НИЖЕ ИДЕТ ШПАРГАЛКА. ОНА НЕ ВЛИЯЕТ НА РАБОТУ ПРОЕКТА,
# ТАК КАК КАЖДАЯ СТРОЧКА НАЧИНАЕТСЯ С СИМВОЛА # (КОММЕНТАРИЙ).
# ==============================================================================

# ==============================================================================
#                        ШПАРГАЛКА ПО ФАЙЛУ .editorconfig
# ==============================================================================
#
# ЧТО ЭТО ТАКОЕ?
# Это "свод правил дорожного движения" для текстовых редакторов (IntelliJ, VS Code и т.д.).
# Он заставляет редакторы кода ставить пробелы, переносы строк и отступы
# ОДИНАКОВО у всех разработчиков, независимо от их операционной системы.
#
# АНАЛОГИЯ (Андрей и Вася пишут книгу):
# Андрей пишет с большими отступами (в 4 пробела) и использует ручку с толстым стержнем.
# Вася пишет без отступов и использует тонкую ручку. Когда они сшивают свои страницы
# в одну книгу, получается визуальный хаос.
# .editorconfig — это инструкция, которую они оба подписали:
# "Пишем только тонкими ручками (2 пробела), без лишних точек в конце строк".
# Благодаря этому, когда Андрей откроет файл Васи, он увидит его точно в таком же
# виде, в каком его писал Вася.
#
# ЗАЧЕМ ЭТО НУЖНО НА САМОМ ДЕЛЕ?
# 1. Чистый Git. Если Андрей (Windows) и Вася (Mac) будут работать без этого файла,
#    Git будет считать, что они изменили ВЕСЬ файл целиком, хотя они поменяли одну букву
#    (потому что у них разные символы переноса строк).
# 2. Красивые Pull Request'ы. Вы не будете видеть тысячи изменений там, где их нет.
# ==============================================================================


# ==============================================================================
# РАЗБОР КАЖДОЙ СТРОЧКИ (Что и почему происходит)
# ==============================================================================

# --- ГЛАВНАЯ КОМАНДА ---
# root = true
# Это значит: "Этот файл — самый главный. Не ищи другие настройки в папках выше".
# Если этого не написать, IDE может применить настройки из вашей домашней папки,
# которые испортят проект.

# --- НАСТРОЙКИ ДЛЯ ВСЕХ ФАЙЛОВ (Звездочка [*]) ---

# charset = utf-8
# Кодировка текста. UTF-8 — это мировой стандарт. Благодаря ей русские буквы
# и смайлики не превратятся в "кракозябры" (непонятные символы).

# end_of_line = lf
# Символ переноса строки.
# Windows по умолчанию ставит два символа (CRLF), а Linux и Mac — один (LF).
# Мы приказываем всем использовать LF (как на Linux). Это спасает Git от "мусорных"
# изменений, когда кажется, что изменен весь файл, хотя поменялась одна буква.

# insert_final_newline = true
# Вставлять пустую строку в самом конце файла.
# Стандарт программирования. Если её нет, некоторые инструменты начинают ругаться.

# trim_trailing_whitespace = true
# Удалять невидимые пробелы в конце каждой строки.
# Если Андрей случайно нажмет пробел в конце строки и не заметит этого, IDE
# сама удалит его при сохранении. Меньше мусора в коде.

# indent_style = space
# Делать отступы ПРОБЕЛАМИ, а не табуляцией (клавишей Tab).
# Табуляция отображается по-разному в разных IDE (где-то шире, где-то уже).
# Пробелы выглядят одинаково у всех.

# indent_size = 2
# Количество пробелов для одного отступа. Два — стандарт для XML, YAML,
# а также для Java в некоторых командах. (В Java чаще используют 4, но
# здесь команда решила использовать 2).


# --- ИСКЛЮЧЕНИЕ ДЛЯ WINDOWS СКРИПТОВ ---
# [*.{bat,cmd}]
# end_of_line = crlf
# Это ВАЖНОЕ ИСКЛЮЧЕНИЕ. Файлы .bat и .cmd (скрипты для Windows)
# ФИЗИЧЕСКИ НЕ РАБОТАЮТ, если внутри них используются переносы строк LF (как в Linux).
# Поэтому для этих конкретных файлов мы приказываем IDE использовать CRLF (как на Windows).
# Это показывает, что .editorconfig — умный файл, он может задавать правила
# как для всего проекта сразу, так и для отдельных типов файлов.